{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "lint": {},
    "preview": {},
    "format": {}
  },
  "boundaries": {
    "tags": {
      "platform": {
        "dependencies": {
          "deny": ["modules"]
        }
      },
      "modules": {
        "dependencies": {
          "deny": ["modules"]
        }
      }
    }
  }
}
